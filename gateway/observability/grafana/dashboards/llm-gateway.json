    {
      "type": "timeseries",
      "title": "Tokens by model, per minute",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 15,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (model, kind) (rate(gateway_tokens_total[$__rate_interval])) * 60",
          "legendFormat": "{{model}} {{kind}}",
