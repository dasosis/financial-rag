    {
      "type": "row",
      "title": "Providers and limits",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "id": 16,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Circuit breakers (per replica)",
      "description": "Each provider's breaker in each replica: open after 5 failures in a row, a probe after 30 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 17,
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (provider, instance) (gateway_breaker_state)",
          "legendFormat": "{{provider}} \u00b7 {{instance}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "closed",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "half-open",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "open",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Limiter",
      "description": "DEGRADED: the replica can't reach the limits' Redis and keeps a third of the limits itself.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 18,
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (instance) (gateway_limiter_degraded)",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "shared (Redis)",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "DEGRADED: local limits",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
