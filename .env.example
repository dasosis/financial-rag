OPENAI_API_KEY=sk-your-key-here

# Usage limits (see README "Usage limits"); 0 turns one off
# QUESTIONS_PER_MONTH=50
# UPLOADS_PER_MONTH=3
# QUESTIONS_PER_MINUTE=5
# QUESTIONS_PER_DAY_ALL_USERS=500

# Model for every language-model call (see config.py); compare with eval_answers.py
# CHAT_MODEL=gpt-4o-mini

# Login: the API verifies each request's Cognito ID token against these.
# Same pool and app client as .streamlit/secrets.toml; neither is a secret.
# COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
# COGNITO_CLIENT_ID=<app-client-id>

# SEC EDGAR: required to check figures against the SEC's XBRL data. The SEC asks
# every automated request to say who is asking: "<app name> <your email>".
# SEC_USER_AGENT=financial-rag you@example.com

# LLM gateway (gateway/, see README "LLM gateway"): send every model call through it
# instead of straight to OpenAI. Off when unset. Start it with
# `docker compose --profile gateway up -d`; the gateway gets the same key.
# LLM_GATEWAY_URL=http://llm-gateway:8080/v1
# LLM_GATEWAY_KEY=<a long random string, 16 characters or more>
# Grafana's admin password, for `--profile metrics` (it won't start without one)
# GRAFANA_ADMIN_PASSWORD=

# The gateway's own settings go in .env.gateway, which only it reads (all optional
# except the OpenAI key; defaults in gateway/README.md):
# OPENAI_API_KEY=sk-your-key-here     # moved here from this file once the API uses the gateway
# OPENROUTER_API_KEY=sk-or-...        # the backup provider; no backup without it
# GATEWAY_BACKUP_MODELS=gpt-4o-mini=openai/gpt-4o-mini
# GATEWAY_RATE_PER_CONSUMER=60        # calls a minute per user; GATEWAY_BURST_PER_CONSUMER=20
# GATEWAY_RATE_GLOBAL=300             # calls a minute, everyone; GATEWAY_BURST_GLOBAL=60
# GATEWAY_DAILY_BUDGET_USER=320000    # weighted tokens per user per UTC day
# GATEWAY_REDACT=all                  # or off, or e.g. email,phone
# GATEWAY_CACHE_TTL=168h

# Tracing (tracing.py): send each question's spans to an OTLP/HTTP collector, such as
# the Jaeger in compose.yaml (`docker compose --profile tracing up -d`). Off when unset.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# TRACE_CONSOLE=1                     # or print spans to the log instead
